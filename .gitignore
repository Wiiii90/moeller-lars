# Secrets and local runtime configuration
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Dependencies and build output
/node_modules
/vendor
/public/build
/public/hot
/public/storage
/dist
/build
/.cache
/resources/views/filament/generated/analytics-world-map.blade.php

# Logs and local tooling
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime storage contents; Laravel directory placeholders remain tracked.
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/phpstan/
/storage/logs/*
!/storage/logs/.gitignore
/storage/*.key
/storage/local-validation-snapshot/

# Runtime media, legacy snapshots and database backups must stay outside Git.
/uploads/
/backups/
/legacy-snapshot*.json
