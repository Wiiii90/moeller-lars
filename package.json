{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:analytics-map": "node resources/scripts/generate-analytics-map.mjs",
        "build": "npm run generate:analytics-map && vite build",
        "dev": "npm run generate:analytics-map && vite",
        "test:js": "node --test tests/js/*.test.mjs",
        "test:browser": "playwright test --config=playwright.config.mjs",
    "test:browser:component": "playwright test --config=playwright.config.mjs --project=component-chromium",
    "test:browser:e2e": "playwright test --config=playwright.config.mjs --project=e2e-chromium",
    "test:browser:profile": "playwright test --config=playwright.config.mjs --project=profiling-chromium"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "concurrently": "^10.0.3",
        "echarts": "^6.1.0",
        "laravel-vite-plugin": "^3.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
