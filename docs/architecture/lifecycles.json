          "from": "published",
          "to": "draft",
          "action": "primary media deleted",
          "source": "app/Domain/Media/MediaAssetEditorialService.php",
          "anchor": "if ($removedPrimary && (string) $artwork->getAttribute('state') === 'published')"
        }
      ]
    },
    {
      "id": "site-section",
      "title": "SiteSection",
      "states": [
        "hidden",
        "published"
      ],
      "transitions": [
        {
          "from": "hidden",
          "to": "published",
          "action": "updatePlacement",
          "source": "app/Domain/Content/SiteSectionEditorialService.php",
          "anchor": "public function updatePlacement("
        },
        {
          "from": "published",
          "to": "hidden",
          "action": "updatePlacement (not Home)",
          "source": "app/Domain/Content/SiteSectionEditorialService.php",
          "anchor": "Home is always published."
        }
      ]
    },
    {
      "id": "media-asset",
      "title": "MediaAsset",
      "states": [
        "available",
        "deleted"
      ],
      "transitions": [
        {
          "from": "[*]",
          "to": "available",
          "action": "ingest",
          "source": "app/Domain/Media/MediaIngestService.php",
          "anchor": "private function storePreparedLocked("
        },
        {
          "from": "available",
          "to": "deleted",
          "action": "logical delete",
          "source": "app/Domain/Media/MediaAssetEditorialService.php",
          "anchor": "$locked->setAttribute('state', 'deleted')"
        }
      ]
    }
  ]
}
