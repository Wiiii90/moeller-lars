        {
          "from": "published",
          "to": "unpublished",
          "action": "unpublish",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "onlyFrom: 'published'"
        },
        {
          "from": "draft",
          "to": "archived",
          "action": "archive",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "return $this->transition($post, 'archived', 'archived')"
        },
        {
          "from": "scheduled",
          "to": "archived",
          "action": "archive",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "return $this->transition($post, 'archived', 'archived')"
        },
        {
          "from": "published",
          "to": "archived",
