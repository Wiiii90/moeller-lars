    },
    {
      "id": "exhibition",
      "title": "Exhibition",
      "states": [
        "draft",
        "published",
        "archived",
        "removed"
      ],
      "transitions": [
        {
          "from": "[*]",
          "to": "draft",
          "action": "createDraft",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "public function createDraft("
        },
        {
          "from": "draft",
          "to": "published",
          "action": "publish",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "return $this->transition($entry, 'published', ['draft', 'archived']"
        },
        {
          "from": "archived",
          "to": "published",
          "action": "publish",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "return $this->transition($entry, 'published', ['draft', 'archived']"
        },
        {
          "from": "published",
          "to": "draft",
          "action": "unpublish",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "return $this->transition($entry, 'draft', ['published']"
        },
        {
          "from": "draft",
          "to": "archived",
          "action": "archive",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "$fresh->setAttribute('archived_from_state', $current)"
        },
        {
          "from": "published",
          "to": "archived",
          "action": "archive",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "$fresh->setAttribute('archived_from_state', $current)"
        },
        {
          "from": "archived",
          "to": "published",
          "action": "restore if ready",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "if ($target === 'published')"
        },
        {
          "from": "archived",
          "to": "draft",
          "action": "restore / downgrade",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "$target = 'draft';"
        },
        {
          "from": "draft",
          "to": "removed",
          "action": "delete",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "public function delete("
        },
        {
          "from": "archived",
          "to": "removed",
          "action": "delete",
          "source": "app/Domain/Content/ExhibitionEditorialService.php",
          "anchor": "public function delete("
        }
      ]
    },
    {
