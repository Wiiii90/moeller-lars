          "anchor": "public function createDraft("
        },
        {
          "from": "draft",
          "to": "published",
          "action": "publish",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "public function publish("
        },
        {
          "from": "scheduled",
          "to": "published",
          "action": "publish",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "public function publish("
        },
        {
          "from": "unpublished",
          "to": "published",
          "action": "publish",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "public function publish("
        },
        {
          "from": "draft",
          "to": "scheduled",
          "action": "schedule",
          "source": "app/Domain/Content/BlogEditorialService.php",
          "anchor": "public function schedule("
